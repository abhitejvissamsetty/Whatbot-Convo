# Mock mode runs without npm installation. Never expose mock mode to the internet.
APP_MODE=mock
STORE_NAME=Store Desk
ASSISTANT_ENABLED=true
NOTIFICATIONS_ENABLED=true
# If you load an env file from another location, set this to the same file.
# CONFIG_ENV_PATH=/etc/wa-commerce/app.env
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
PUBLIC_URL=http://localhost:3000
STORE_DRIVER=memory
# Set true with MySQL to refuse accidental in-memory storage.
REQUIRE_PERSISTENCE=false
# MySQL 8.0+; use a dedicated account. Store database contains customer PII.
MYSQL_URL=
META_APP_SECRET=local-meta-secret-change-me
META_VERIFY_TOKEN=local-verify-token-change-me
WOO_WEBHOOK_SECRET=local-woo-secret-change-me
# Live mode requires explicit API versions/model and staging configuration.
META_GRAPH_VERSION=
META_TOKEN=
META_PHONE_NUMBER_ID=
META_FLOW_ID=
FLOW_PRIVATE_KEY_PATH=
FLOW_PRIVATE_KEY_PASSPHRASE=
# Choose one AI provider. Only its credentials/model are required in live mode.
# openai | anthropic | gemini | deepseek | groq | openrouter | ollama | compatible
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_VERSION=2026-10-21
GEMINI_API_KEY=
GEMINI_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_API_KEY=
OLLAMA_MODEL=
# Custom OpenAI-compatible Chat Completions service.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
WOO_URL=
WOO_KEY=
WOO_SECRET=
WOO_BRIDGE_SECRET=
# JSON object: event -> {name,language}; templates each take order ID and status.
META_TEMPLATES={}
FLOW_TTL_MINUTES=30
RETENTION_DAYS=30
AI_DAILY_TURN_LIMIT=50
AI_MAX_TOOL_CALLS=8
AI_MAX_OUTPUT_TOKENS=600
RECONCILE_INTERVAL_SECONDS=300
# Required for live mode: configure staging/sandbox first.
INTEGRATION_ENVIRONMENT=staging
# Mock-only bootstrap; no operator is created unless both values are provided.
MOCK_OPERATOR_EMAIL=
MOCK_OPERATOR_PASSWORD=

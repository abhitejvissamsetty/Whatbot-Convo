# Place limit_req_zone directives in the http context.
limit_req_zone $binary_remote_addr zone=wa_general:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=wa_login:10m rate=5r/m;

server {
    listen 443 ssl;
    server_name REPLACE_WITH_YOUR_DOMAIN;
    ssl_certificate /REPLACE/fullchain.pem;
    ssl_certificate_key /REPLACE/privkey.pem;
    client_max_body_size 256k;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location = /api/operator/login {
        limit_req zone=wa_login burst=5 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
    }
    location / {
        limit_req zone=wa_general burst=100 nodelay;
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 45s;
    }
    # Meta verification query strings contain secrets; do not use default access logs.
    access_log off;
}
